#!/usr/bin/env bash
# SessionStart hook: inject the Heirloom convention and project index.
# Without Node 20+ it injects a one-line notice and never blocks the session.

case "$0" in
  */* | *\\*) HOOK_DIR="${0%[/\\]*}" ;;
  *) HOOK_DIR="." ;;
esac

# shellcheck source=node-env
. "${HOOK_DIR}/node-env"
heirloom_find_node

if [ -z "$NODE_BIN" ]; then
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"Heirloom 비활성: Node 20 이상이 필요합니다. 설치 후 세션을 다시 시작하세요."}}'
  exit 0
fi

exec "$NODE_BIN" "${HOOK_DIR}/../skills/using-heirloom/scripts/hook-session-start.mjs"
