{
  "schemaVersion": 1,
  "baseBranch": "main",
  "specGlobs": [
    "docs/superpowers/specs/**",
    "**/specs/**/*.md"
  ],
  "recall": {
    "maxRecords": 8,
    "maxTokens": 6000
  },
  "testCadence": {
    "mode": "off"
  },
  "probe": {
    "setup": [],
    "maxProbes": 10,
    "setupTimeoutSeconds": 600,
    "testTimeoutSeconds": 600
  },
  "spec": {
    "afterMerge": "delete"
  }
}
