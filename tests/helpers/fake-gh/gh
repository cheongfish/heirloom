#!/usr/bin/env node
// Fake `gh` for tests. Appends its argv to $FAKE_GH_LOG and answers from $FAKE_GH_STATE:
// { "authed": true, "prs": [{ "number", "url", "state", "headRefName", "baseRefName" }], "fail": "network" }
import { appendFileSync, readFileSync } from 'node:fs';

const args = process.argv.slice(2);
if (process.env.FAKE_GH_LOG) appendFileSync(process.env.FAKE_GH_LOG, `${JSON.stringify(args)}\n`);
let state = { authed: true, prs: [] };
try {
  state = { ...state, ...JSON.parse(readFileSync(String(process.env.FAKE_GH_STATE), 'utf8')) };
} catch {
  // defaults
}
const flag = (name) => {
  const i = args.indexOf(name);
  return i === -1 ? undefined : args[i + 1];
};

if (args[0] === '--version') {
  process.stdout.write('gh version 2.0.0-fake\n');
} else if (args[0] === 'auth' && args[1] === 'status') {
  if (!state.authed) {
    process.stderr.write('You are not logged into any GitHub hosts.\n');
    process.exit(1);
  }
} else if (args[0] === 'pr' && args[1] === 'list') {
  if (state.fail === 'network') {
    process.stderr.write('error connecting to api.github.com\n');
    process.exit(1);
  }
  const head = flag('--head');
  const wanted = flag('--state') ?? 'open';
  const prs = state.prs.filter((p) => p.headRefName === head && (wanted === 'all' || p.state.toLowerCase() === wanted));
  process.stdout.write(JSON.stringify(prs));
} else if (args[0] === 'pr' && args[1] === 'view') {
  if (state.fail === 'network') {
    process.stderr.write('error connecting to api.github.com\n');
    process.exit(1);
  }
  const pr = state.prs.find((p) => p.url === args[2]);
  if (!pr) {
    process.stderr.write(`no pull requests found for ${args[2]}\n`);
    process.exit(1);
  }
  process.stdout.write(JSON.stringify({ state: pr.state }));
} else {
  process.stderr.write(`fake gh: unsupported ${args.join(' ')}\n`);
  process.exit(2);
}
