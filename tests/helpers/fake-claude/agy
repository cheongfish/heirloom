#!/usr/bin/env node
// Fake `agy` for tests (the Antigravity headless profile). Appends { args, cwd } to
// $FAKE_CLAUDE_LOG and plays the phase named by the prompt (`agy -p <prompt> …`) with
// scenario.mjs. With $FAKE_AGY_DENY it does what agy does in print mode when a tool needs a
// permission the rules do not give: it prints the notice on stderr and exits with 0.
import { appendFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const args = process.argv.slice(2);
if (process.env.FAKE_CLAUDE_LOG) appendFileSync(process.env.FAKE_CLAUDE_LOG, `${JSON.stringify({ args, cwd: process.cwd() })}\n`);
if (process.env.FAKE_AGY_DENY) {
  process.stderr.write('jetski: no output produced — a tool required the "command" permission that headless mode cannot prompt for, so it was auto-denied.\n');
  process.exit(0);
}
const prompt = args[args.indexOf('-p') + 1] ?? '';
const phase = prompt.includes('curate-decisions') ? 'curate' : prompt.includes('apply-approval') ? 'apply' : null;
const taskId = /task (t-\d{8}-[0-9a-z]{8})/.exec(prompt)?.[1];
if (!phase || !taskId) {
  process.stderr.write('fake agy: unknown prompt\n');
  process.exit(2);
}
const scenario = path.join(path.dirname(fileURLToPath(import.meta.url)), 'scenario.mjs');
process.exit(spawnSync(process.execPath, [scenario, phase, taskId], { stdio: 'inherit' }).status ?? 1);
