#!/usr/bin/env node
// Fake `claude` for tests. Appends { args, cwd } to $FAKE_CLAUDE_LOG. Exits with
// $FAKE_CLAUDE_EXIT when it is set; otherwise plays the phase named by the prompt
// (curate-decisions or apply-approval) with scenario.mjs and exits with its status.
import { appendFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const args = process.argv.slice(2);
if (process.env.FAKE_CLAUDE_LOG) appendFileSync(process.env.FAKE_CLAUDE_LOG, `${JSON.stringify({ args, cwd: process.cwd() })}\n`);
if (process.env.FAKE_CLAUDE_EXIT) process.exit(Number(process.env.FAKE_CLAUDE_EXIT));

const prompt = args[args.indexOf('-p') + 1] ?? '';
const phase = prompt.includes('curate-decisions') ? 'curate' : prompt.includes('apply-approval') ? 'apply' : null;
const taskId = /task (t-\d{8}-[0-9a-z]{8})/.exec(prompt)?.[1];
if (!phase || !taskId) {
  process.stderr.write('fake claude: unknown prompt\n');
  process.exit(2);
}
const scenario = path.join(path.dirname(fileURLToPath(import.meta.url)), 'scenario.mjs');
const result = spawnSync(process.execPath, [scenario, phase, taskId], { stdio: 'inherit' });
process.exit(result.status ?? 1);
