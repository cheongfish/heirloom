#!/usr/bin/env node
// Fake `glab` for tests. Appends its argv to $FAKE_GLAB_LOG and answers from $FAKE_GLAB_STATE:
// { "hosts": ["gitlab.com"], "mrs": [{ "iid", "web_url", "state", "source_branch", "target_branch", "project" }],
//   "fail": "network", "createUrl": "…" }
// `hosts` are the hosts `glab auth status --hostname` accepts. `project` is the project path.
// `mr create` and `mr update` write back to the state file, so a later lookup finds the MR and
// its description can be checked (used by the acceptance runs).
import { appendFileSync, readFileSync, writeFileSync } from 'node:fs';

const args = process.argv.slice(2);
if (process.env.FAKE_GLAB_LOG) appendFileSync(process.env.FAKE_GLAB_LOG, `${JSON.stringify(args)}\n`);
let state = { hosts: ['gitlab.com'], mrs: [] };
try {
  state = { ...state, ...JSON.parse(readFileSync(String(process.env.FAKE_GLAB_STATE), 'utf8')) };
} catch {
  // defaults
}
function save() {
  if (process.env.FAKE_GLAB_STATE) writeFileSync(process.env.FAKE_GLAB_STATE, JSON.stringify(state, null, 2));
}
/** `--repo` given as a URL (https://host/group/project) or as a path. */
function repoOf() {
  const repo = flag('--repo') ?? flag('-R');
  if (!repo) return { host: 'gitlab.com', project: 'acme/widgets' };
  const m = /^https?:\/\/([^/]+)\/(.+?)(?:\.git)?\/?$/.exec(repo);
  return m ? { host: m[1], project: m[2] } : { host: 'gitlab.com', project: repo };
}
const flag = (name) => {
  const i = args.indexOf(name);
  return i === -1 ? undefined : args[i + 1];
};
const network = () => {
  if (state.fail !== 'network') return;
  process.stderr.write('dial tcp: lookup gitlab.com: connection refused\n');
  process.exit(1);
};

if (args[0] === '--version') {
  process.stdout.write('glab version 1.36.0 (fake)\n');
} else if (args[0] === 'auth' && args[1] === 'status') {
  const host = flag('--hostname');
  if (!state.hosts.includes(host)) {
    process.stderr.write(`x ${host}: no token configured\n`);
    process.exit(1);
  }
} else if (args[0] === 'api') {
  network();
  const endpoint = args.find((a, i) => i > 0 && !a.startsWith('-') && args[i - 1] !== '--hostname');
  const url = new URL(endpoint, 'https://fake.invalid/');
  const m = /^\/projects\/([^/]+)\/merge_requests(?:\/(\d+))?$/.exec(url.pathname);
  if (!m) {
    process.stderr.write(`fake glab: unsupported endpoint ${endpoint}\n`);
    process.exit(2);
  }
  const project = decodeURIComponent(m[1]);
  const mrs = state.mrs.filter((mr) => mr.project === project);
  if (m[2]) {
    const mr = mrs.find((x) => String(x.iid) === m[2]);
    if (!mr) {
      process.stderr.write('glab: 404 Not Found (HTTP 404)\n');
      process.exit(1);
    }
    process.stdout.write(JSON.stringify(mr));
  } else {
    const source = url.searchParams.get('source_branch');
    const wanted = url.searchParams.get('state');
    process.stdout.write(JSON.stringify(mrs.filter((mr) => (!source || mr.source_branch === source) && (!wanted || mr.state === wanted))));
  }
} else if (args[0] === 'mr' && args[1] === 'create') {
  const { host, project } = repoOf();
  const iid = state.mrs.reduce((n, m) => Math.max(n, m.iid), 0) + 1;
  const web_url = state.createUrl ?? `https://${host}/${project}/-/merge_requests/${iid}`;
  state.mrs.push({ iid, web_url, state: 'opened', source_branch: flag('--source-branch'), target_branch: flag('--target-branch'), project, title: flag('--title'), description: flag('--description') ?? '' });
  save();
  // Real glab prints a progress line before the URL.
  process.stdout.write(`\nCreating merge request for ${flag('--source-branch')} into ${flag('--target-branch')} in ${project}\n\n!${iid} ${flag('--title')} (${flag('--source-branch')})\n ${web_url}\n\n`);
} else if (args[0] === 'mr' && args[1] === 'update') {
  const mr = state.mrs.find((m) => String(m.iid) === args[2]);
  if (!mr) {
    process.stderr.write(`404 Not Found: merge request ${args[2]}\n`);
    process.exit(1);
  }
  if (flag('--description') !== undefined) mr.description = flag('--description');
  if (flag('--title') !== undefined) mr.title = flag('--title');
  save();
  process.stdout.write(`${mr.web_url}\n`);
} else {
  process.stderr.write(`fake glab: unsupported ${args.join(' ')}\n`);
  process.exit(2);
}
